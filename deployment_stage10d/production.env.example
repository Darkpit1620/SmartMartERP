# EXAMPLE ONLY — DO NOT ENTER REAL SECRETS HERE OR COMMIT A FILLED COPY.
# Set these values in your cloud host's PRIVATE environment-variable controls.
DJANGO_SETTINGS_MODULE=config.settings_production
SMARTMART_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
SMARTMART_ALLOWED_HOSTS=store.example.com
SMARTMART_CSRF_TRUSTED_ORIGINS=https://store.example.com
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
SMARTMART_MEDIA_ROOT=/mnt/persistent/smartmart-media
# Only if platform guarantees trusted proxy header sanitization:
SMARTMART_TRUST_PROXY_HTTPS=0
# Keep 0 until HTTPS and domain are verified; then roll out HSTS cautiously.
SMARTMART_HSTS_SECONDS=0
